<Project>
  <PropertyGroup>
    <!-- C#_net648.0 : entire monolith uses this one Customer Version. -->
    <AppTargetFramework>net48</AppTargetFramework>
    <TargetFramework>$(AppTargetFramework)</TargetFramework>
    <CustomerVersion>648.0</CustomerVersion>
    <BranchName>C#_net648.0</BranchName>
    <Scenario>1 - Monolithic</Scenario>
    <ModuleLayout>flat (single module)</ModuleLayout>
    <ProjectTypeName>Blazor WebAssembly Application</ProjectTypeName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
</Project>
